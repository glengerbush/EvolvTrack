# Environment variables expanded by `env(...)` in supabase/config.toml.
#
# Local dev: copy this file to `supabase/.env` (gitignored). The Supabase CLI
# auto-loads it when you run `supabase start`, `supabase db reset`, etc.
#
# Production push: do NOT use these localhost values. Set the env vars to
# production URLs in the shell or CI runner before running
# `supabase config push --project-ref <ref>` (see supabase/README.md).

SUPABASE_AUTH_SITE_URL=http://localhost:5173
SUPABASE_AUTH_REDIRECT_URL=http://localhost:5173/**

# Resend SMTP API key. Local dev with `supabase start` routes outbound mail to
# the in-tree inbucket viewer, so leaving this empty locally is fine. The
# value MUST be set in the shell / CI environment before `supabase config
# push` — Supabase will store it as the SMTP password on the hosted project.
RESEND_API_KEY=
